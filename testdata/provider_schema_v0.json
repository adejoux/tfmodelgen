{
  "format_version": "1.0",
  "provider_schemas": {
    "registry.terraform.io/adejoux/demo": {
      "provider": {"version": 0, "block": {}},
      "resource_schemas": {
        "demo_other": {
          "version": 2,
          "block": {"attributes": {"id": {"type": "string", "computed": true}}}
        },
        "demo_widget": {
          "version": 0,
          "block": {
            "attributes": {
              "id": {"type": "string", "computed": true},
              "name": {"type": "string", "required": true},
              "enabled": {"type": "bool", "optional": true, "computed": true},
              "size": {"type": "number", "optional": true},
              "ratio": {"type": "number", "optional": true},
              "labels": {"type": ["map", "string"], "optional": true},
              "tags": {"type": ["set", "string"], "optional": true},
              "ports": {"type": ["list", "number"], "optional": true},
              "password": {"type": "string", "optional": true, "sensitive": true},
              "token": {"type": "string", "optional": true, "write_only": true},
              "extra": {"type": "dynamic", "optional": true},
              "endpoint": {"type": ["object", {"host": "string", "port": "number"}], "optional": true},
              "routes": {"type": ["list", ["object", {"cidr": "string", "metric": "number"}]], "optional": true},
              "settings": {
                "nested_type": {
                  "nesting_mode": "single",
                  "attributes": {
                    "mode": {"type": "string", "optional": true},
                    "max_items": {"type": "number", "optional": true}
                  }
                },
                "optional": true
              },
              "members": {
                "nested_type": {
                  "nesting_mode": "list",
                  "attributes": {
                    "email": {"type": "string", "required": true},
                    "role": {"type": "string", "optional": true}
                  }
                },
                "optional": true
              }
            },
            "block_types": {
              "rule": {
                "nesting_mode": "list",
                "block": {
                  "attributes": {
                    "priority": {"type": "number", "required": true},
                    "action": {"type": "string", "optional": true}
                  },
                  "block_types": {
                    "target": {
                      "nesting_mode": "single",
                      "block": {"attributes": {"kind": {"type": "string", "optional": true}}}
                    }
                  }
                }
              },
              "timeouts": {
                "nesting_mode": "single",
                "block": {"attributes": {"create": {"type": "string", "optional": true}}}
              }
            }
          }
        }
      }
    }
  }
}
